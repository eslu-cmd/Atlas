+    groups=[{'scope':'BODY','node':node({'CL':'WHITE'})},{'scope':'BODY','node':bad}]
+    if reverse:groups.reverse()
+    with self.subTest(bad=bad,reverse=reverse),self.assertRaises(SpecError):
+     self.e.encode(node({'MA':'APTX'},groups))
